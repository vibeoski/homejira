#!/usr/bin/env bash
# pre-commit: fast local checks (build + lint + Postman guard). Runs in < 30s.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── Postman collection guard ───────────────────────────────────────────────────
# If any handler or route file is staged, the collection must also be staged.
API_FILES_PATTERN="backend/internal/handler/|backend/internal/server/server.go"
COLLECTION_FILE="postman/HomeJira.postman_collection.json"

staged=$(git diff --cached --name-only)
api_changed=$(echo "$staged" | grep -E "$API_FILES_PATTERN" || true)
collection_changed=$(echo "$staged" | grep -F "$COLLECTION_FILE" || true)

if [[ -n "$api_changed" && -z "$collection_changed" ]]; then
  echo ""
  echo "╔══════════════════════════════════════════════════════════════════╗"
  echo "║  BLOCKED: API changed but Postman collection not updated         ║"
  echo "╠══════════════════════════════════════════════════════════════════╣"
  echo "║                                                                  ║"
  echo "║  Changed API files:                                              ║"
  while IFS= read -r f; do
    printf  "║    • %-61s║\n" "$f"
  done <<< "$api_changed"
  echo "║                                                                  ║"
  echo "║  Required action:                                                ║"
  echo "║    1. Update postman/HomeJira.postman_collection.json            ║"
  echo "║    2. Ask Claude to sync via Postman MCP (putCollection)         ║"
  echo "║    3. git add postman/HomeJira.postman_collection.json           ║"
  echo "║    4. Re-run git commit                                          ║"
  echo "║                                                                  ║"
  echo "║  To skip (not recommended): git commit --no-verify               ║"
  echo "╚══════════════════════════════════════════════════════════════════╝"
  echo ""
  exit 1
fi

# ── Build + lint ───────────────────────────────────────────────────────────────
echo "==> [pre-commit] Go build + vet"
cd "$REPO_ROOT/backend"
go build ./... 2>&1
go vet ./... 2>&1

echo "==> [pre-commit] Frontend build + lint"
cd "$REPO_ROOT/frontend"
npm run build --silent 2>&1
npm run lint 2>&1

echo "==> [pre-commit] All checks passed."
