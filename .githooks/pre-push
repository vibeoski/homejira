#!/usr/bin/env bash
# pre-push: run tests and enforce 80% coverage before pushing.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
MIN_COVERAGE=80

echo "==> [pre-push] Running backend tests with coverage..."
cd "$REPO_ROOT/backend"
go test ./internal/service/... -coverprofile=coverage.out -covermode=atomic 2>&1

# Extract integer part of coverage (e.g. "80.3%" → "80")
COVERAGE_RAW=$(go tool cover -func=coverage.out | grep "^total" | awk '{print $3}' | tr -d '%')
COVERAGE_INT=${COVERAGE_RAW%.*}
echo "==> [pre-push] Coverage: ${COVERAGE_RAW}%  (minimum: ${MIN_COVERAGE}%)"

rm -f coverage.out

if [ "$COVERAGE_INT" -lt "$MIN_COVERAGE" ]; then
  echo "ERROR: Coverage ${COVERAGE_RAW}% is below the required ${MIN_COVERAGE}%. Aborting push."
  exit 1
fi

echo "==> [pre-push] Coverage check passed."
